        "\n",
        "    con.close()\n",
        "    fator = peso_g / 100.0\n",
        "    calorias, proteina, gordura, carbo, fibra, sodio, fonte = linha\n",
        "    return {\n",
        "        \"peso_g\": peso_g,\n",
        "        \"calories\": round(calorias * fator, 1),\n",
        "        \"protein_g\": round(proteina * fator, 1),\n",
